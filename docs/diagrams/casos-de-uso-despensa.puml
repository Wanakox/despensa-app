@startuml
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
actor Visitante as A1
actor Usuario as A2
actor "Miembro del hogar" as A3
actor "Propietario del hogar" as A4
actor "Firebase Authentication" as Firebase
A3 --|> A2
A4 --|> A3
rectangle "Despensa" {
  package "Cuenta y sesión" {
    usecase "CU-01\nRegistrarse" as CU_01
    usecase "CU-02\nIniciar sesión" as CU_02
    usecase "CU-03\nCerrar sesión" as CU_03
  }
  package "Hogar" {
    usecase "CU-04\nCrear hogar" as CU_04
    usecase "CU-05\nConsultar hogar activo" as CU_05
    usecase "CU-06\nInvitar miembro" as CU_06
    usecase "CU-07\nConsultar miembros" as CU_07
    usecase "CU-08\nRetirar miembro" as CU_08
  }
  package "Inventario" {
    usecase "CU-09\nConsultar inventario" as CU_09
    usecase "CU-10\nAñadir producto" as CU_10
    usecase "CU-11\nModificar producto" as CU_11
    usecase "CU-12\nEliminar producto" as CU_12
    usecase "CU-13\nAjustar cantidad" as CU_13
    usecase "CU-14\nBuscar productos" as CU_14
  }
  package "Cesta compartida" {
    usecase "CU-15\nConsultar cesta" as CU_15
    usecase "CU-16\nAñadir elemento a la cesta" as CU_16
    usecase "CU-17\nModificar elemento de la cesta" as CU_17
    usecase "CU-18\nRetirar elemento de la cesta" as CU_18
    usecase "CU-19\nMarcar o desmarcar como comprado" as CU_19
  }
}
A1 --> CU_01
Firebase --> CU_01
A2 --> CU_02
Firebase --> CU_02
A2 --> CU_03
Firebase --> CU_03
A2 --> CU_04
A3 --> CU_05
A4 --> CU_06
A3 --> CU_07
A4 --> CU_08
A3 --> CU_09
A3 --> CU_10
A3 --> CU_11
A3 --> CU_12
A3 --> CU_13
A3 --> CU_14
A3 --> CU_15
A3 --> CU_16
A3 --> CU_17
A3 --> CU_18
A3 --> CU_19
@enduml
